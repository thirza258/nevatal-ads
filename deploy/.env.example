# Copy to deploy/.env and replace every value marked CHANGE_ME.
# deploy/.env is ignored by git and must never be committed.
#
# Production public origin: https://ads.nevatal.id
# Public HTTPS is provided by Cloudflare Tunnel. cloudflared connects from the
# host to the loopback-only HTTP port below, so no inbound web port is exposed.

# production enables strict secret/password checks and hides default credentials.
ADCONTROL_ENV=production

# Generate with: openssl rand -hex 32
# Changing SECRET_KEY invalidates click tokens and breaks IP-hash continuity.
# Admin sessions are independent database rows; change the password to end them.
SECRET_KEY=CHANGE_ME_openssl_rand_hex_32

# Used only when the database has no administrator yet. Minimum 12 characters.
ADMIN_EMAIL=CHANGE_ME_admin_email
ADMIN_PASSWORD=CHANGE_ME_at_least_12_characters

# nginx is loopback-only by default so the dashboard is never exposed over
# plain HTTP. Cloudflare Tunnel connects to 127.0.0.1:${HTTP_PORT}.
# Set HTTP_BIND=0.0.0.0 only if you intentionally expose plain HTTP.
HTTP_BIND=127.0.0.1
HTTP_PORT=18080

# Must match the owner of ./data on the host (id -u / id -g).
ADCONTROL_UID=1000
ADCONTROL_GID=1000

# Analytics retention and automatic SQLite backups.
EVENT_RETENTION_DAYS=180
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION=14

# Canonical public origin for learning SEO (sitemap.xml, robots.txt, metadata).
# Production value: https://ads.nevatal.id
# No path, no trailing slash. Use the HTTPS origin even though cloudflared
# forwards plain HTTP to the loopback web port.
PUBLIC_BASE_URL=https://ads.nevatal.id
